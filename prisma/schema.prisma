generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  name      String?
  image     String?
  password  String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bio        String?
  website    String?
  location   String?
  isVerified Boolean  @default(false)
  isAdmin    Boolean  @default(false)

  designs   Design[]
  ownedDesigns Design[] @relation("DesignOwnership")
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
  cart      CartItem[]
  earnings  SellerEarning[]
  sellerAccount SellerAccount?
  purchases Purchase[]
  contactMessages ContactMessage[]
  chatSessions ChatSession[]
  resources Resource[]
  paystackTransfers PaystackTransfer[]
  transferNotifications TransferNotification[]

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Design {
  id           String   @id @default(cuid()) @map("_id")
  title        String
  description  String?
  price        Float
  ownershipPrice Float?  // Higher price for ownership option
  imageUrl     String   // Primary/thumbnail image for listings
  thumbnailUrl String?
  tags         String[]
  category     String
  isActive     Boolean  @default(true)
  approvalStatus String @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  buyingTypes  String   @default("REGULAR") // REGULAR, OWNERSHIP, BOTH
  isOwned      Boolean  @default(false)
  ownedBy      String?  // User ID who owns the design (for ownership purchases)
  featured     Boolean  @default(false) // Admin-selected featured designs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  designerId String
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)
  owner      User?  @relation("DesignOwnership", fields: [ownedBy], references: [id])

  totalSales   Int    @default(0)
  totalRevenue Float  @default(0)

  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  cart       CartItem[]
  earnings   SellerEarning[]
  purchases  Purchase[]
  mediaFiles DesignMedia[]

  @@map("designs")
}

model DesignMedia {
  id          String   @id @default(cuid()) @map("_id")
  fileName    String   // Original filename
  fileUrl     String   // Storage URL
  fileType    String   // IMAGE, VIDEO
  mimeType    String   // image/jpeg, video/mp4, etc.
  fileSize    Int      // File size in bytes
  duration    Int?     // For videos - duration in seconds
  accessType  String   @default("FREE") // FREE, PREMIUM
  sortOrder   Int      @default(0) // Display order
  createdAt   DateTime @default(now())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("design_media")
}

model Order {
  id            String   @id @default(cuid()) @map("_id")
  orderNumber   String   @unique
  status        String   @default("PENDING")
  totalAmount   Float
  platformFee   Float    
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  stripePaymentIntentId String?
  stripeFeeId           String?

  items OrderItem[]
  earnings SellerEarning[]

  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid()) @map("_id")
  quantity     Int    @default(1)
  price        Float
  purchaseType String @default("REGULAR") // REGULAR or OWNERSHIP

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
  @@map("favorites")
}

model CartItem {
  id           String   @id @default(cuid()) @map("_id")
  quantity     Int      @default(1)
  purchaseType String   @default("REGULAR") // REGULAR or OWNERSHIP
  createdAt    DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId, purchaseType])
  @@map("cart_items")
}

model SellerEarning {
  id               String   @id @default(cuid()) @map("_id")
  saleAmount       Float    // Original sale amount (what customer paid)
  platformCommission Float  // 5% commission taken by platform
  sellerAmount     Float    // Amount seller receives (95% of sale)
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("seller_earnings")
}

model Purchase {
  id            String   @id @default(cuid()) @map("_id")
  purchaseType  String   // REGULAR or OWNERSHIP
  accessGranted Boolean  @default(true)
  purchasePrice Float
  createdAt     DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  orderId  String

  @@unique([userId, designId, purchaseType])
  @@map("purchases")
}

model SellerAccount {
  id               String   @id @default(cuid()) @map("_id")
  accountNumber    String   // Bank account number
  accountName      String   // Account holder name
  bankName         String   // Bank name
  bankCode         String   // Bank code for transfers
  recipientCode    String?  // Paystack recipient code for transfers
  subaccountCode   String?  // Paystack subaccount code for split payments
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_accounts")
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String
  message   String
  priority  String   @default("medium") // low, medium, high, urgent
  status    String   @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contact_messages")
}

model ChatSession {
  id        String   @id @default(cuid()) @map("_id")
  status    String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(cuid()) @map("_id")
  message    String
  senderId   String
  senderName String
  senderRole String   // USER, ADMIN
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Resource {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String
  type        String   // guide, template, tool, tutorial, reference, inspiration
  category    String   // design-fundamentals, color-theory, technical-drawing, pattern-making, digital-tools, photography
  difficulty  String   // beginner, intermediate, advanced
  format      String   // pdf, video, web, download, article
  url         String?
  downloadUrl String?
  thumbnail   String   @default("/api/placeholder/300/200")
  duration    String?
  rating      Float    @default(0)
  views       Int      @default(0)
  featured    Boolean  @default(false)
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("resources")
}

model PaystackTransfer {
  id              String   @id @default(cuid()) @map("_id")
  orderId         String   // Order that triggered the transfer
  designId        String   // Design being paid for
  sellerId        String   // Seller receiving payment
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  amountUSD       Float    // Amount in USD (seller's 90%)
  amountNGN       Float    // Amount in NGN (converted)
  exchangeRate    Float    // Exchange rate used
  
  paystackReference String? // Paystack transfer reference
  paystackStatus  String   @default("PENDING") // PENDING, SUCCESS, FAILED
  
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  lastRetryAt     DateTime?
  
  errorMessage    String?
  failureReason   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  succeededAt     DateTime?
  
  @@map("paystack_transfers")
}

model TransferNotification {
  id              String   @id @default(cuid()) @map("_id")
  transferId      String
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  type            String   // SUCCESS, FAILED, PENDING, RETRY
  message         String
  isRead          Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  readAt          DateTime?
  
  @@map("transfer_notifications")
}

model Settings {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}