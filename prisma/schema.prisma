generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  name      String?
  image     String?
  password  String?
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Password Reset Fields
  resetToken       String?
  resetTokenExpiry DateTime?
  
  // Email Verification Fields
  emailVerified    Boolean  @default(false)
  verifyToken      String?
  verifyTokenExpiry DateTime?

  bio        String?
  website    String?
  location   String?
  isVerified Boolean  @default(false)
  isAdmin    Boolean  @default(false)
  
  // Enhanced Profile Fields
  displayName     String?
  coverImage      String?
  socialLinks     Json?      // { instagram, twitter, pinterest, behance, dribbble }
  specialties     String[]   // Fashion illustration, Pattern design, etc.
  experience      String?    // Years of experience
  education       String?
  achievements    String[]
  portfolioUrl    String?
  
  // Verification & Trust
  verificationStatus  String   @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  verificationDate    DateTime?
  verificationBadge   String?  // RISING_STAR, TOP_SELLER, VERIFIED_PRO
  designerTier        String?  // DESIGNER, GOLD_DESIGNER, VIP_DESIGNER, VVIP_DESIGNER
  designerTierUpdatedAt DateTime?
  trustScore          Float    @default(0)
  
  // Analytics Fields
  profileViews    Int      @default(0)
  totalSales      Int      @default(0)
  totalEarnings   Float    @default(0)
  avgRating       Float    @default(0)
  responseTime    Int?     // Average response time in hours
  
  // Referral System
  referralCode      String?           // User's unique referral code (enforced at app level)
  referredBy        String?           // ID of user who referred them
  totalReferrals    Int      @default(0)
  referralEarnings  Float    @default(0)
  
  // Notification Preferences
  emailNotifications  Boolean @default(true)
  pushNotifications   Boolean @default(true)

  // Commission Settings
  acceptsCommissions    Boolean  @default(false)  // Designer must opt-in to receive commissions
  commissionStatus      String   @default("CLOSED") // OPEN, BUSY, CLOSED
  commissionMinBudget   Float?   // Minimum budget for commissions
  commissionMaxBudget   Float?   // Maximum budget (optional)
  commissionTurnaround  String?  // e.g., "2-4 weeks", "1 month"
  commissionTypes       String[] // Types of work: "Custom Design", "Alterations", "Full Pattern", etc.
  commissionTerms       String?  // Custom terms/conditions for commissions
  commissionQueueSize   Int?     // How many active commissions they can handle

  // Print-on-Demand (POD) Settings
  acceptsPOD            Boolean  @default(false)  // Designer must opt-in to offer POD products
  podDefaultMarkup      Float    @default(20)     // Default markup percentage for POD products
  podAutoApprove        Boolean  @default(true)   // Auto-approve POD product requests

  designs   Design[]
  ownedDesigns Design[] @relation("DesignOwnership")
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
  cart      CartItem[]
  earnings  SellerEarning[]
  sellerAccount SellerAccount?
  purchases Purchase[]
  contactMessages ContactMessage[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[] @relation("ChatMessageSender")
  resources Resource[]
  paystackTransfers PaystackTransfer[]
  transferNotifications TransferNotification[]
  notifications Notification[]

  accounts Account[]
  sessions Session[]
  
  // Social Features
  followers       Follow[]  @relation("Following")
  following       Follow[]  @relation("Followers")
  commissions     Commission[]
  commissionRequests Commission[] @relation("CommissionRequests")
  
  // Commission Request System (Admin-mediated)
  commissionRequestsBy  CommissionRequest[] @relation("CommissionRequestsBy")
  commissionRequestsFor CommissionRequest[] @relation("CommissionRequestsFor")
  
  // Community Features
  forumPosts      ForumPost[]
  forumComments   ForumComment[]
  contestEntries  ContestEntry[]
  contestsCreated Contest[]
  
  // Analytics
  designViews     DesignView[]
  trafficSources  TrafficSource[]
  
  // Direct Messaging
  messagesSent     DirectMessage[] @relation("MessagesSent")
  messagesReceived DirectMessage[] @relation("MessagesReceived")
  
  // Fashion Boutique (Physical Products)
  boutiqueProducts       BoutiqueProduct[] @relation("BoutiqueSeller")
  boutiqueOrdersBuyer    BoutiqueOrder[] @relation("BoutiqueOrderBuyer")
  boutiqueOrdersSeller   BoutiqueOrder[] @relation("BoutiqueOrderSeller")
  boutiqueCart           BoutiqueCartItem[] @relation("BoutiqueCart")
  boutiqueFavorites      BoutiqueFavorite[] @relation("BoutiqueFavorites")
  boutiqueReviews        BoutiqueReview[] @relation("BoutiqueReviews")
  boutiquePayouts        BoutiqueSellerPayout[] @relation("BoutiquePayouts")
  sellerShipments        SellerToAdminShipment[] @relation("SellerShipments")
  boutiqueReturns        BoutiqueReturn[] @relation("BoutiqueReturns")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Design {
  id           String   @id @default(cuid()) @map("_id")
  title        String
  description  String?
  price        Float
  ownershipPrice Float?  // Higher price for ownership option
  imageUrl     String   // Primary/thumbnail image for listings
  thumbnailUrl String?
  watermarkedUrl String? // Watermarked preview image
  tags         String[]
  category     String
  isActive     Boolean  @default(true)
  approvalStatus String @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  buyingTypes  String   @default("REGULAR") // REGULAR, OWNERSHIP, BOTH
  isOwned      Boolean  @default(false)
  ownedBy      String?  // User ID who owns the design (for ownership purchases)
  featured     Boolean  @default(false) // Admin-selected featured designs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Draft Workflow
  isDraft      Boolean  @default(false)  // True if design is a draft (not published)
  publishedAt  DateTime?                 // When design was first published
  
  // Inventory/Stock Management
  stockType    String   @default("UNLIMITED") // UNLIMITED, LIMITED, SOLD_OUT
  stockQuantity Int?                          // null for unlimited, 0+ for limited
  lowStockThreshold Int? @default(5)          // Alert when stock falls below this

  designerId String
  designer   User   @relation(fields: [designerId], references: [id], onDelete: Cascade)
  owner      User?  @relation("DesignOwnership", fields: [ownedBy], references: [id])

  totalSales   Int    @default(0)
  totalRevenue Float  @default(0)
  
  // Enhanced Discovery & Search
  style           String?   // Minimalist, Bold, Vintage, Modern, etc.
  colorPalette    String[]  // Primary colors in the design
  garmentType     String?   // Dress, Suit, Casual, Sportswear, etc.
  season          String?   // Spring, Summer, Fall, Winter, All-Season
  occasion        String?   // Casual, Formal, Wedding, Party, etc.
  targetAudience  String?   // Women, Men, Unisex, Kids
  
  // Trending & Analytics
  viewCount       Int      @default(0)
  weeklyViews     Int      @default(0)
  monthlyViews    Int      @default(0)
  trendingScore   Float    @default(0)
  lastTrendingCalc DateTime?
  
  // Licensing
  licenseType     String   @default("STANDARD") // STANDARD, EXTENDED, EXCLUSIVE
  licenseTerms    String?
  usageRights     String[] // Print, Digital, Commercial, Personal

  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
  cart       CartItem[]
  earnings   SellerEarning[]
  purchases  Purchase[]
  mediaFiles DesignMedia[]
  podConfigs DesignPODConfig[]
  
  // New Relations
  views      DesignView[]
  licenses   License[]
  similarTo  DesignSimilarity[] @relation("SimilarDesigns")
  similarFrom DesignSimilarity[] @relation("SourceDesigns")
  
  // Commission requests that reference this design
  commissionReferences CommissionRequest[] @relation("ReferenceDesign")

  @@map("designs")
}

// POD (Print-on-Demand) product configuration for a design
model DesignPODConfig {
  id          String   @id @default(cuid()) @map("_id")
  designId    String
  design      Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  
  provider    String   // printful, printify, gooten, printivo
  productId   String   // Product ID from the provider (e.g., "printful_12")
  productName String   // Human-readable name
  variantIds  String[] // Selected variant IDs
  markup      Float    @default(30) // Markup percentage (30 = 30%)
  enabled     Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([designId, productId])
  @@index([designId])
  @@index([provider])
  @@map("design_pod_configs")
}

model DesignMedia {
  id          String   @id @default(cuid()) @map("_id")
  fileName    String   // Original filename
  fileUrl     String   // Storage URL
  fileType    String   // IMAGE, VIDEO
  mimeType    String   // image/jpeg, video/mp4, etc.
  fileSize    Int      // File size in bytes
  duration    Int?     // For videos - duration in seconds
  accessType  String   @default("FREE") // FREE, PREMIUM
  sortOrder   Int      @default(0) // Display order
  createdAt   DateTime @default(now())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("design_media")
}

model Order {
  id            String   @id @default(cuid()) @map("_id")
  orderNumber   String   @unique
  status        String   @default("PENDING")
  totalAmount   Float
  platformFee   Float    
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paidAt        DateTime?

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  // Order type: DIGITAL (design download) or POD (print-on-demand physical)
  orderType     String   @default("DIGITAL") // DIGITAL, POD

  // Payment method tracking
  paymentMethod String?  // STRIPE, PAYSTACK, MPESA, FLUTTERWAVE
  paymentError  String?

  // Stripe
  stripePaymentIntentId String?
  stripeFeeId           String?

  // M-Pesa (Kenya/Tanzania)
  mpesaCheckoutRequestId  String?
  mpesaMerchantRequestId  String?
  mpesaReceiptNumber      String?
  mpesaTransactionDate    String?
  mpesaPhoneNumber        String?

  // Flutterwave (Pan-African)
  flutterwaveRef           String?
  flutterwaveTransactionId String?
  flutterwaveFlwRef        String?

  // POD (Print-on-Demand) fields
  podProvider        String?  // printful, printify
  podOrderId         String?  // External order ID from POD provider
  podStatus          String?  // pending, in_production, shipped, delivered
  trackingNumber     String?
  trackingUrl        String?
  estimatedDelivery  DateTime?
  
  // Shipping address for POD orders
  shippingName       String?
  shippingAddress1   String?
  shippingAddress2   String?
  shippingCity       String?
  shippingState      String?
  shippingCountry    String?
  shippingZip        String?
  shippingPhone      String?

  items OrderItem[]
  earnings SellerEarning[]

  @@index([paymentMethod])
  @@index([orderType])
  @@index([podProvider])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid()) @map("_id")
  quantity     Int    @default(1)
  price        Float
  purchaseType String @default("REGULAR") // REGULAR, OWNERSHIP, or POD

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id])

  // POD-specific fields
  podProductId   String?  // Product ID from POD catalog (printful_123, printify_456)
  podVariantId   String?  // Variant ID (size/color combination)
  podProductName String?  // "Unisex Cotton Tee - Black / XL"
  
  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
  @@map("favorites")
}

model CartItem {
  id           String   @id @default(cuid()) @map("_id")
  quantity     Int      @default(1)
  purchaseType String   @default("REGULAR") // REGULAR, OWNERSHIP, or POD
  createdAt    DateTime @default(now())
  
  // POD-specific fields
  podProductId   String?  // e.g., "printful_12"
  podProductName String?  // e.g., "Unisex Cotton Tee"
  podProvider    String?  // e.g., "printful", "printify"
  podPrice       Float?   // Price including markup

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId, purchaseType, podProductId])
  @@map("cart_items")
}

model SellerEarning {
  id               String   @id @default(cuid()) @map("_id")
  saleAmount       Float    // Original sale amount (what customer paid)
  platformCommission Float  // 5% commission taken by platform
  sellerAmount     Float    // Amount seller receives (95% of sale)
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@map("seller_earnings")
}

model Purchase {
  id            String   @id @default(cuid()) @map("_id")
  purchaseType  String   // REGULAR or OWNERSHIP
  accessGranted Boolean  @default(true)
  purchasePrice Float
  createdAt     DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  orderId  String

  @@unique([userId, designId, purchaseType])
  @@map("purchases")
}

model SellerAccount {
  id               String   @id @default(cuid()) @map("_id")
  accountNumber    String   // Bank account number
  accountName      String   // Account holder name
  bankName         String   // Bank name
  bankCode         String   // Bank code for transfers
  recipientCode    String?  // Paystack recipient code for transfers
  subaccountCode   String?  // Paystack subaccount code for split payments
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_accounts")
}

model ContactMessage {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String
  message   String
  priority  String   @default("medium") // low, medium, high, urgent
  status    String   @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("contact_messages")
}

model ChatSession {
  id        String   @id @default(cuid()) @map("_id")
  status    String   @default("ACTIVE") // ACTIVE, CLOSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         String   @id @default(cuid()) @map("_id")
  message    String
  senderId   String
  senderName String
  senderRole String   // USER, ADMIN
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  sender    User @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Resource {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String
  type        String   // guide, template, tool, tutorial, reference, inspiration
  category    String   // design-fundamentals, color-theory, technical-drawing, pattern-making, digital-tools, photography
  difficulty  String   // beginner, intermediate, advanced
  format      String   // pdf, video, web, download, article
  url         String?
  downloadUrl String?
  thumbnail   String   @default("/api/placeholder/300/200")
  duration    String?
  rating      Float    @default(0)
  views       Int      @default(0)
  featured    Boolean  @default(false)
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("resources")
}

model PaystackTransfer {
  id              String   @id @default(cuid()) @map("_id")
  orderId         String   // Order that triggered the transfer
  designId        String   // Design being paid for
  sellerId        String   // Seller receiving payment
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  amountUSD       Float    // Amount in USD (seller's 90%)
  amountNGN       Float    // Amount in NGN (converted)
  exchangeRate    Float    // Exchange rate used
  
  paystackReference String? // Paystack transfer reference
  paystackStatus  String   @default("PENDING") // PENDING, SUCCESS, FAILED
  
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  lastRetryAt     DateTime?
  
  errorMessage    String?
  failureReason   String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  succeededAt     DateTime?
  
  @@map("paystack_transfers")
}

model TransferNotification {
  id              String   @id @default(cuid()) @map("_id")
  transferId      String
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  type            String   // SUCCESS, FAILED, PENDING, RETRY
  message         String
  isRead          Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  readAt          DateTime?
  
  @@map("transfer_notifications")
}

// General in-app notifications
model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // COMMISSION_MESSAGE, ORDER_UPDATE, PAYMENT, SYSTEM, etc.
  title     String
  message   String
  data      Json?    // Additional context (commissionId, orderId, etc.)
  
  isRead    Boolean  @default(false)
  readAt    DateTime?
  
  // Soft delete for audit trail
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, isDeleted])
  @@index([createdAt])
  @@map("notifications")
}

model Settings {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================
// FEATURE 1: Intellectual Property Protection
// ============================================

model License {
  id              String   @id @default(cuid()) @map("_id")
  licenseNumber   String   @unique
  type            String   // STANDARD, EXTENDED, EXCLUSIVE
  purchaseDate    DateTime @default(now())
  expiryDate      DateTime?
  
  // Rights granted
  printRights     Boolean  @default(false)
  digitalRights   Boolean  @default(true)
  commercialUse   Boolean  @default(false)
  exclusiveUse    Boolean  @default(false)
  modifications   Boolean  @default(false)
  
  // Usage tracking
  downloadCount   Int      @default(0)
  maxDownloads    Int      @default(5)
  lastDownload    DateTime?
  
  // Verification
  certificateUrl  String?
  verificationCode String  @unique
  
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  userId   String
  orderId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("licenses")
}

// ============================================
// FEATURE 2: Social Proof & Discovery
// ============================================

model Follow {
  id          String   @id @default(cuid()) @map("_id")
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  
  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model DesignSimilarity {
  id            String   @id @default(cuid()) @map("_id")
  sourceId      String
  similarId     String
  score         Float    // Similarity score 0-1
  createdAt     DateTime @default(now())
  
  source  Design @relation("SourceDesigns", fields: [sourceId], references: [id], onDelete: Cascade)
  similar Design @relation("SimilarDesigns", fields: [similarId], references: [id], onDelete: Cascade)

  @@unique([sourceId, similarId])
  @@map("design_similarities")
}

// ============================================
// FEATURE 3: Advanced Search & Discovery
// ============================================

model DesignView {
  id        String   @id @default(cuid()) @map("_id")
  designId  String
  userId    String?
  sessionId String?
  source    String?  // search, category, trending, similar, direct
  createdAt DateTime @default(now())
  
  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("design_views")
}

model SearchHistory {
  id        String   @id @default(cuid()) @map("_id")
  query     String
  filters   Json?
  results   Int      @default(0)
  userId    String?
  sessionId String?
  createdAt DateTime @default(now())

  @@map("search_history")
}

model TrendingDesign {
  id           String   @id @default(cuid()) @map("_id")
  designId     String   @unique
  rank         Int
  score        Float
  period       String   // DAILY, WEEKLY, MONTHLY
  calculatedAt DateTime @default(now())
  
  @@map("trending_designs")
}

model Collection {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  description String?
  coverImage  String?
  isPublic    Boolean  @default(true)
  isCurated   Boolean  @default(false) // Admin-curated collections
  season      String?
  theme       String?
  designIds   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collections")
}

// ============================================
// FEATURE 5: Seller Analytics & Tools
// ============================================

model TrafficSource {
  id        String   @id @default(cuid()) @map("_id")
  sellerId  String
  source    String   // direct, search, social, referral, email
  medium    String?
  campaign  String?
  visits    Int      @default(1)
  date      DateTime @default(now())
  
  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("traffic_sources")
}

model Promotion {
  id          String   @id @default(cuid()) @map("_id")
  sellerId    String
  type        String   // DISCOUNT, BUNDLE, FEATURED_SLOT
  name        String
  description String?
  
  // Discount settings
  discountType  String?  // PERCENTAGE, FIXED
  discountValue Float?
  
  // Bundle settings
  designIds   String[]
  bundlePrice Float?
  
  // Validity
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  
  // Usage tracking
  usageCount Int @default(0)
  maxUsage   Int?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

