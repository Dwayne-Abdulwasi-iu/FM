{
  "name": "fashion-marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-static.js",
    "start": "next start -p $PORT",
    "start:standalone": "node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env.local",
    "start:standalone:3000": "set PORT=3000 && node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env.local",
    "start:standalone:3001": "set PORT=3001 && node -r dotenv/config .next/standalone/server.js dotenv_config_path=.env.local",
    "start:render": "node .next/standalone/server.js",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.0",
    "@stripe/stripe-js": "^2.4.0",
    "archiver": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "clsx": "^2.0.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.303.0",
    "mongodb": "^7.0.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.12",
    "nodemailer": "^7.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "stripe": "^14.25.0",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8.4.32",
    "prisma": "^5.7.0",
    "puppeteer": "^24.29.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
